// =====================================================================
// PATHTRICK Prisma Schema
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ENUMS
// =====================================================================

// Role model (DREAMER, CHASER, ADMIN)

enum AssessmentType {
  DREAMER_RIASEC // Asesmen minat/bakat (dipakai kalau fakultas belum diisi)
  DREAMER_PREFERENCE // Budget, preferensi negara, preferensi fakultas
  CHASER_PROFILE // CV (wajib), portofolio (opsional), jurusan, preferensi kerja
}

enum GenerationSource {
  AI // Berhasil digenerate oleh LLM
  FALLBACK // Rule-based fallback dipakai (LLM gagal/timeout/rate limit)
}

enum RoadmapStatus {
  ACTIVE // Roadmap yang sedang dipakai user
  SUPERSEDED // Digantikan roadmap baru hasil re-assessment
}

enum CourseStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_REVIEW
  COMPLETED // Lulus = semua CourseSection berhasil dilewati (quiz tiap
  // section >= passing grade section tsb)
  FAILED // Belum lulus di section tertentu, boleh re-submit quiz-nya
}

enum QuestionType {
  MULTIPLE_CHOICE // MVP: fokus di sini, auto-grading deterministik, TANPA AI
  ESSAY // disiapkan untuk masa depan; kalau dipakai, butuh alur review sendiri
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum BadgeStatus {
  EARNED // Lulus course, badge off-chain diterbitkan
}

enum NotificationType {
  CERTIFICATE_STATUS_CHANGED
  SYSTEM_MESSAGE
}

enum AgentName {
  AGENT_1_DREAMER
  AGENT_2_CHASER
  AGENT_3_COURSE_GENERATOR
  AGENT_3_EVALUATOR
}

enum AICallStatus {
  SUCCESS
  FALLBACK_USED
  FAILED
}

enum RiasecCategory {
  R // Realistic
  I // Investigative
  A // Artistic
  S // Social
  E // Enterprising
  C // Conventional
}

// =====================================================================
// AUTH & USER
// =====================================================================

// =====================================================================
// ROLE
// =====================================================================

model Role {
  id           String   @id @default(cuid())
  name         String   @unique // "DREAMER" | "CHASER" | "ADMIN"
  displayName  String // "The Dreamer" | "The Chaser" | "Administrator"
  title        String   @default("")
  description  String // teks panjang untuk UI pemilihan karakter
  perks        Json // ["Asesmen Minat & Bakat", ...]
  iconUrl      String? // pixel-art NPC image path, mis. "/NPC High School Student.png"
  color        String   @default("#6366f1")
  glow         String   @default("rgba(99,102,241,0.5)")
  tag          String?
  isSelectable Boolean  @default(true)
  sortOrder    Int      @default(0) // urutan tampil di UI
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users User[]
}

model User {
  id                String    @id @default(cuid())
  privyId           String    @unique // DID dari Privy, sumber identitas login
  email             String?   @unique
  name              String?
  // roleId null sampai user selesai memilih persona (DREAMER/CHASER) di onboarding
  roleId            String?
  role              Role?     @relation(fields: [roleId], references: [id])
  walletAddress     String?   @unique // Wallet address dari embedded wallet Privy â€” diisi HANYA saat user connect wallet, wajib dilakukan sebelum klaim sertifikat. BUKAN otomatis saat login
  walletConnectedAt DateTime? // kapan user menyelesaikan connect wallet
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  assessments    Assessment[]
  roadmaps       Roadmap[]
  courseProgress CourseProgress[]
  skillBadges    SkillBadge[]
  certificates   Certificate[]
  achievements   Achievement[]
  notifications  Notification[]
  questProgress  UserQuestProgress[]
  loginEvents    UserLoginEvent[]
  gamification   Gamification?

  // Back-relations untuk master data yang di-create admin
  universitiesCreated University[]  @relation("UniversityCreatedBy")
  scholarshipsCreated Scholarship[] @relation("ScholarshipCreatedBy")
  jobsCreated         Job[]         @relation("JobCreatedBy")
  skillsCreated       Skill[]       @relation("SkillCreatedBy")
  coursesCreated      Course[]      @relation("CourseCreatedBy")

  @@index([roleId])
}

// =====================================================================
// ASSESSMENT & RIASEC
// =====================================================================

model Assessment {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // roleName: snapshot nama role saat assessment dibuat ("DREAMER" | "CHASER").
  // Disimpan sebagai String bukan FK ke Role â€” supaya histori assessment
  // tidak berubah kalau user ganti role di kemudian hari.
  roleName  String
  type      AssessmentType
  payload   Json // bentuk berbeda tergantung `type`, divalidasi via Zod di app layer
  version   Int            @default(1)
  isActive  Boolean        @default(true) // hanya 1 aktif per (userId, type)
  createdAt DateTime       @default(now())

  riasecResult RiasecResult?
  roadmap      Roadmap?

  @@index([userId, type, isActive])
}

// Hasil skoring RIASEC â€” murni kalkulasi deterministik (bukan output AI),
// jadi paling "demo-safe" di seluruh sistem: tidak tergantung LLM sama sekali.
model RiasecResult {
  id           String     @id @default(cuid())
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String
  scores       Json // { "R": 12, "I": 8, "A": 15, "S": 6, "E": 10, "C": 9 }
  topCode      String // contoh: "AIE" (3 tipe dominan, urutan skor tertinggi)
  createdAt    DateTime   @default(now())

  @@index([userId])
}

// =====================================================================
// ROADMAP & MATCHING CACHE (hasil AI Agent 1 / Agent 2)
// =====================================================================

model Roadmap {
  id           String           @id @default(cuid())
  assessmentId String           @unique
  assessment   Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // roleName: snapshot role saat roadmap dibuat â€” sama seperti Assessment.roleName,
  // tidak berubah walau user ganti role di kemudian hari.
  roleName     String
  content      Json // tahapan roadmap, skill_gap (Chaser), catatan match/mismatch CV vs minat
  status       RoadmapStatus    @default(ACTIVE)
  generatedBy  GenerationSource @default(AI)
  createdAt    DateTime         @default(now())

  courses            RoadmapCourse[]
  universityMatches  UniversityMatch[]
  scholarshipMatches ScholarshipMatch[]
  jobMatches         JobMatch[]

  @@index([userId, status])
}

model RoadmapCourse {
  id                String   @id @default(cuid())
  roadmapId         String
  roadmap           Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id])
  order             Int
  reasonRecommended String?
  createdAt         DateTime @default(now())

  @@unique([roadmapId, courseId])
}

// =====================================================================
// MASTER DATA (seed manual oleh Admin)
// =====================================================================

model University {
  id                    String   @id @default(cuid())
  name                  String
  country               String
  coverImageUrl         String?
  location              String?
  riasecCode            String?
  accreditation         String?
  description           String? // ditampilkan di University Hub & admin panel
  facultyTags           String[] // dipakai buat matching ke preferensi_fakultas / RIASEC top_code
  estimatedCostMin      Int?
  estimatedCostMax      Int?
  admissionRequirements String?
  website               String?
  // createdByUserId: User.id dari admin yang menambahkan data ini.
  // Nullable supaya seed awal bisa pakai id dummy sebelum ada user admin.
  createdByUserId       String?
  createdByUser         User?    @relation("UniversityCreatedBy", fields: [createdByUserId], references: [id])
  createdAt             DateTime @default(now())

  matches UniversityMatch[]

  @@index([country])
}

model UniversityMatch {
  id           String     @id @default(cuid())
  roadmapId    String
  roadmap      Roadmap    @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  universityId String
  university   University @relation(fields: [universityId], references: [id])
  matchScore   Int // 0-100
  reasoning    String?
  createdAt    DateTime   @default(now())

  @@unique([roadmapId, universityId])
}

model Scholarship {
  id                String   @id @default(cuid())
  name              String
  country           String
  deadline          DateTime
  requirements      String
  requiredDocuments String[]
  facultyTags       String[]
  scope             String // "dalam_negeri" | "luar_negeri" | "keduanya"
  provider          String?
  amount            String?
  officialUrl       String?
  coverImageUrl     String?
  createdByUserId   String?
  createdByUser     User?    @relation("ScholarshipCreatedBy", fields: [createdByUserId], references: [id])
  createdAt         DateTime @default(now())

  matches ScholarshipMatch[]

  @@index([deadline])
}

model ScholarshipMatch {
  id                String      @id @default(cuid())
  roadmapId         String
  roadmap           Roadmap     @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  scholarshipId     String
  scholarship       Scholarship @relation(fields: [scholarshipId], references: [id])
  matchScore        Int
  documentChecklist Json // status kelengkapan dokumen per item, diupdate user
  reasoning         String?
  createdAt         DateTime    @default(now())

  @@unique([roadmapId, scholarshipId])
}

model Job {
  id              String   @id @default(cuid())
  title           String
  company         String
  type            String // "internship" | "entry_level"
  // Sengaja TETAP String[] (bukan relasi ke Skill) â€” data lowongan kerja
  // biasanya diambil admin dari sumber eksternal apa adanya (istilah skill
  // bisa beragam/tidak baku). Matching ke Skill dilakukan di application
  // layer (fuzzy/text match), bukan FK rigid. Kalau nanti mau diperketat
  // jadi relasi juga, ini titik yang perlu diubah â€” didiskusikan dulu.
  skillsRequired  String[]
  location        String?
  salaryRange     String?
  coverImageUrl   String?
  description     String?
  applyUrl        String?
  createdByUserId String?
  createdByUser   User?    @relation("JobCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  matches JobMatch[]
}

model JobMatch {
  id         String   @id @default(cuid())
  roadmapId  String
  roadmap    Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id])
  matchScore Int
  skillGap   String[] // skill yang masih kurang -> jadi dasar rekomendasi course tambahan
  reasoning  String?
  createdAt  DateTime @default(now())

  @@unique([roadmapId, jobId])
}

// Skill sebagai master data tersendiri (bukan lagi sekadar Course.skillTags
// string) â€” supaya bisa punya cover/ikon buat Skill Tree & admin panel.
model Skill {
  id              String   @id @default(cuid())
  name            String   @unique
  coverImageUrl   String? // ikon yang tampil di Skill Tree
  description     String?
  createdByUserId String?
  createdByUser   User?    @relation("SkillCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  courses Course[] // implicit many-to-many
}

// =====================================================================
// LEARNING MISSION
//
// Hirarki yang sesuai dengan Frontend:
//   House (rumah/fakultas)            â†’ model House
//   â””â”€â”€ Module/Stage (modul)          â†’ model Course
//         â””â”€â”€ Chapter/BAB (bab)       â†’ model CourseChapter
//               â””â”€â”€ Level (section)  â†’ model CourseSection
//                     â””â”€â”€ Quiz       â†’ model Quiz
//
// House dipakai untuk SMA (Dreamer) â€” mengelompokkan Course per fakultas.
// Mahasiswa (Chaser) tidak perlu House â€” Course.houseId nullable.
// =====================================================================

// House = "rumah" per jurusan/fakultas di peta utama (Dreamer/SMA).
// Sesuai mockBackendData.houses di frontend.
model House {
  id             String   @id @default(cuid())
  title          String // "House of ICT"
  description    String // "Pemrograman, Software Dev, Keamanan Siber & AI/ML"
  icon           String // emoji atau path icon, mis. "ðŸ’»"
  houseNumber    Int      @unique // urutan tampil: 1, 2, ... 10
  // Gradient Tailwind class string dari frontend, mis. "from-blue-500 via-indigo-500 to-sky-500"
  gradient       String   @default("from-indigo-500 to-purple-500")
  // Array skill overview yang tampil di UI house card
  skillsOverview String[]
  // Array kriteria "Ideal For" untuk user
  idealFor       String[]
  // "active" | "locked" â€” apakah house sudah terbuka untuk user
  status         String   @default("active")
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  courses Course[]

  @@index([houseNumber])
  @@index([isPublished])
}

model Course {
  id               String   @id @default(cuid())
  // onChainId adalah integer yang dikirim ke mintCertificate(uint256 courseId)
  // di smart contract. JANGAN gunakan `id` (cuid) untuk ini â€” cuid tidak
  // bisa di-cast ke uint256 Solidity. Backend Engineer: pakai
  // `course.onChainId` (bukan `course.id`) saat call kontrak.
  onChainId        Int      @unique @default(autoincrement())
  title            String // "Modul: Pemrograman & Software Development" atau "React Mastery"
  description      String // deskripsi singkat modul
  coverImageUrl    String? // thumbnail modul
  // Background peta dunia MIKRO khusus course ini â€” tempat karakter
  // berjalan dari chapter ke chapter ("rumah ke rumah"). Nullable â€”
  // Frontend fallback ke template default kalau tidak diisi.
  mapBackgroundUrl String?
  facultyTags      String[] // relevansi ke fakultas (Dreamer)
  // contentType: "material" | "lab" | "project" â€” sesuai Stage.contentType di frontend
  contentType      String   @default("material")
  level            String? // "beginner" | "intermediate" | "advanced"
  // houseId: FK ke House. Nullable â€” Mahasiswa (Chaser) tidak punya House.
  houseId          String?
  house            House?   @relation(fields: [houseId], references: [id])
  createdByUserId  String?
  createdByUser    User?    @relation("CourseCreatedBy", fields: [createdByUserId], references: [id])
  isPublished      Boolean  @default(true)
  isFallback       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  skills         Skill[]
  roadmapCourses RoadmapCourse[]
  progress       CourseProgress[]
  chapters       CourseChapter[]

  @@index([isPublished])
  @@index([houseId])
}

// CourseChapter = "BAB" di dalam sebuah Modul (Course).
// Satu Course/Module terdiri dari beberapa BAB.
// Sesuai Stage.chapters[] di frontend mockBackendData.
model CourseChapter {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String // "BAB 1: Struktur HTML & Semantic Web"
  order         Int // urutan BAB dalam modul (1, 2, 3, ...)
  // duration hint untuk UI, mis. "6 Levels" â€” jumlah section di bab ini
  // (informatif, bukan di-enforce di DB â€” count dari CourseSection)
  durationLabel String   @default("6 Levels")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sections CourseSection[]

  @@unique([courseId, order])
  @@index([courseId])
}

// CourseSection = satu "Level" / satu titik "Rumah" di peta mikro sebuah BAB.
// User navigasi antar section pakai keyboard + tombol E (mekanisme Frontend).
// Backend cukup simpan urutan & status kelulusan tiap section.
model CourseSection {
  id               String        @id @default(cuid())
  // missionId: slug unik yang dipakai Frontend (mis. "html-level-1").
  // Nullable agar section lama tidak pecah — isi saat seed/create baru.
  // Frontend cukup pakai missionId ini; tidak perlu tahu id (cuid) internal.
  missionId        String?       @unique
  courseChapterId  String
  courseChapter    CourseChapter @relation(fields: [courseChapterId], references: [id], onDelete: Cascade)
  title            String // "Level 1: Teori Dasar" | "Level 6: Boss Fight"
  order            Int // urutan Level dalam BAB (1, 2, 3, ...)
  content          String // isi materi teks (Markdown)
  // category: "foundation" | "skill" | "milestone" — sesuai CourseNodeData.category di frontend
  category         String        @default("skill")
  codeTemplate     String?       @db.Text
  expectedKeywords Json?
  xpReward         Int           @default(100) // XP diberikan saat level ini selesai
  // Posisi "rumah" ini di atas mapBackgroundUrl milik Course induk.
  // Kalau null, Frontend auto-layout berdasar `order` saja.
  mapPositionX     Int?
  mapPositionY     Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  quiz Quiz?

  @@unique([courseChapterId, order])
  @@index([courseChapterId])
  @@index([missionId])
}

// ---------------------------------------------------------------------
// QUIZ â€” deterministik, TIDAK butuh AI. Sesuai use case asli:
// "Pengguna mengerjakan quiz; sistem menilai otomatis" (bukan AI Review).
// Sekarang menempel di CourseSection (1 quiz per section), bukan di
// Course langsung.
// ---------------------------------------------------------------------

model Quiz {
  id              String        @id @default(cuid())
  courseSectionId String        @unique
  courseSection   CourseSection @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  title           String? // mis. "Boss Fight: HTML & CSS"
  passingScore    Int           @default(75) // persentase minimum untuk lulus
  randomizeOrder  Boolean       @default(false) // acak urutan soal
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id            String             @id @default(cuid())
  quizId        String
  quiz          Quiz               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type          QuestionType       @default(MULTIPLE_CHOICE)
  prompt        String // "Pertanyaan"
  options       Json? // "Opsi Jawaban (opsional)" â€” [{ id, text }, ...]; null utk tipe non-MCQ
  correctAnswer Json? // "Jawaban benar"; null kalau ESSAY
  points        Int                @default(1) // "Perhitungan skor" â€” nilai poin per soal
  difficulty    QuestionDifficulty @default(MEDIUM) // basis statistik kesulitan butir soal
  order         Int
  createdAt     DateTime           @default(now())

  answers QuizAnswer[]

  @@index([quizId])
}

// Tracker status keseluruhan 1 user di 1 course (agregat lintas section).
// Progress dilacak di level Course â€” bukan per Chapter atau per Section
// (dipilih agar schema ringan; progresi bersifat linear/sequential).
model CourseProgress {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId            String
  course              Course       @relation(fields: [courseId], references: [id])
  status              CourseStatus @default(NOT_STARTED)
  // chapterId + sectionOrder = "cursor" posisi terjauh user dalam course.
  // Section dengan order <= currentSectionOrder pada chapter yang sama =
  // sudah bisa diakses. Chapter sebelumnya = seluruh section sudah unlocked.
  currentChapterOrder Int          @default(1) // order BAB yang sedang dikerjakan
  currentSectionOrder Int          @default(1) // order Level dalam BAB tersebut
  finalScore          Int? // agregat (mis. rata-rata skor semua quiz)
  startedAt           DateTime?
  completedAt         DateTime?

  quizAttempts QuizAttempt[]
  skillBadge   SkillBadge?

  @@unique([userId, courseId])
  @@index([status])
}

model QuizAttempt {
  id               String         @id @default(cuid())
  courseProgressId String
  courseProgress   CourseProgress @relation(fields: [courseProgressId], references: [id], onDelete: Cascade)
  quizId           String
  quiz             Quiz           @relation(fields: [quizId], references: [id])
  // Snapshot posisi saat attempt â€” untuk konteks laporan & analitik
  chapterOrder     Int            @default(1)
  sectionOrder     Int            @default(1)
  score            Int // dihitung deterministik oleh backend, bukan AI
  passed           Boolean
  createdAt        DateTime       @default(now())

  answers QuizAnswer[]

  @@index([courseProgressId])
  @@index([quizId])
}

model QuizAnswer {
  id             String       @id @default(cuid())
  attemptId      String
  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       QuizQuestion @relation(fields: [questionId], references: [id])
  selectedAnswer Json // jawaban mentah user
  isCorrect      Boolean
  createdAt      DateTime     @default(now())

  @@index([questionId]) // basis query statistik kesulitan per butir soal
}

// =====================================================================
// GAMIFIKASI (murni XP â€” keputusan final, tanpa Tier/Rank/Career Base)
// =====================================================================

model Gamification {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp        Int      @default(0) // murni bertambah dari penyelesaian course/section
  updatedAt DateTime @updatedAt
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String // slug unik, mis. "first_course_completed"
  title       String
  description String?
  unlockedAt  DateTime @default(now())

  @@unique([userId, key])
}

// =====================================================================
// WEB3 BRIDGE â€” SkillBadge (off-chain) -> Certificate (on-chain SBT)
// =====================================================================

model SkillBadge {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseProgressId String         @unique
  courseProgress   CourseProgress @relation(fields: [courseProgressId], references: [id])
  // Denormalized dari Course.onChainId untuk menghindari JOIN chain panjang
  // (SkillBadge -> CourseProgress -> Course) setiap kali Backend trigger
  // mint pipeline. Backend Engineer: isi ini saat SkillBadge dibuat,
  // berbarengan dengan CourseProgress.status = COMPLETED.
  courseOnChainId  BigInt
  status           BadgeStatus    @default(EARNED)
  earnedAt         DateTime       @default(now())

  certificate Certificate?

  @@index([userId])
}

model Certificate {
  id              String     @id @default(cuid())
  skillBadgeId    String     @unique
  skillBadge      SkillBadge @relation(fields: [skillBadgeId], references: [id])
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseOnChainId BigInt

  // Data minting â€” diisi saat /prepare-mint dipanggil
  signature String? // EIP-712 Signature (hex)
  nonce     BigInt? // Nonce dari contract.nonces() saat signature dibuat
  deadline  BigInt? // Unix timestamp deadline signature

  // Status: PENDING = signature issued, MINTED = confirmed on-chain
  mintStatus String  @default("PENDING") // "PENDING" | "MINTED"
  txHash     String? // Diisi FE setelah /confirm-mint

  mintedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([mintStatus])
}

// =====================================================================
// OBSERVABILITY â€” dipakai Guardrail (AI-03) untuk logging & debugging
// =====================================================================

model AIInteractionLog {
  id             String       @id @default(cuid())
  userId         String?
  agent          AgentName
  requestPayload Json
  responseRaw    Json?
  status         AICallStatus
  errorMessage   String?
  latencyMs      Int?
  createdAt      DateTime     @default(now())

  @@index([agent, status])
  @@index([createdAt])
}

// =====================================================================
// RIASEC QUESTION BANK
// Soal dimiliki penuh oleh Backend -- Frontend hanya menerima {id, text, order}.
// Kategori TIDAK pernah dikirim ke client untuk mencegah manipulasi skor.
// =====================================================================

model RiasecQuestion {
  id       String         @id // "q01".."q42" -- stable cross-reference key
  text     String
  category RiasecCategory
  order    Int
  isActive Boolean        @default(true)

  @@index([isActive])
}

// ===================================================================== (Agent 3 â€” Course Generator RAG)
// Dokumen pengetahuan per jurusan/bidang â€” ditulis manual oleh admin
// dalam format Markdown, lalu di-embed menjadi vektor (OpenAI
// text-embedding-3-small, 1536 dim) untuk dipakai similarity search
// saat Agent 3 hendak generate course baru.
//
// Strategi chunking MVP: 1 dokumen = 1 row. Kalau konten membengkak
// jadi ribuan token, pecah jadi beberapa row dengan chunk_index berbeda.
//
// Embedding disimpan sebagai Json (array number[]) bukan tipe native vector â€”
// Prisma Postgres managed service (pooled.db.prisma.io) tidak memerlukan
// pgvector extension terpisah. Cosine similarity dihitung in-memory di
// TypeScript (cukup untuk MVP dengan skala puluhan dokumen).
// Kalau nanti scale ke ribuan dokumen, upgrade ke dedicated pgvector.
// =====================================================================

model CourseKnowledge {
  id         String   @id @default(cuid())
  // "teknologi" | "feb" | "hukum" | "kedokteran" | "psikologi" |
  // "pendidikan" | "pertanian" | "sosial-politik" â€” 8 fakultas
  facultyTag String
  title      String // judul topik/modul (contoh: "Dasar Python untuk Teknologi")
  content    String // isi pengetahuan dalam format Markdown
  chunkIndex Int      @default(0) // kalau 1 dokumen dipecah jadi banyak chunk
  // Embedding 1536 dimensi dari OpenAI text-embedding-3-small,
  // disimpan sebagai Json array number[]. Nullable supaya dokumen bisa
  // dimasukkan dulu sebelum embedding di-generate (pipeline async).
  embedding  Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([facultyTag, title, chunkIndex])
  @@index([facultyTag])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String           @db.Text
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

enum QuestType {
  MODULE_COMPLETED
  DAILY_LOGIN
  QUIZ_BOSS_COMPLETED
  SBT_CLAIMED
  CUSTOM
}

model QuestDefinition {
  id          String    @id @default(cuid())
  title       String
  description String
  type        QuestType
  rewardXp    Int       @default(0)
  targetCount Int       @default(1) // For streaks or multi-steps
  // Optional scoping
  courseId    String?
  sectionId   String?
  houseId     String?

  userProgress UserQuestProgress[]
}

model UserQuestProgress {
  id      String          @id @default(cuid())
  userId  String
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId String
  quest   QuestDefinition @relation(fields: [questId], references: [id], onDelete: Cascade)

  progress        Int     @default(0)
  isCompleted     Boolean @default(false)
  isRewardClaimed Boolean @default(false)

  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, questId])
}

model UserLoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateStr   String // e.g. "YYYY-MM-DD" in local/UTC for easy querying
  createdAt DateTime @default(now())

  @@unique([userId, dateStr])
}
